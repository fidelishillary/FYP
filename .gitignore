# ---- SAFETY: never commit samples or derived binaries (NFR-01, NFR-02, PRD 4.2) ----
data/raw/**
data/external/**
data/processed/**
!data/**/.gitkeep
!data/README.md
*.exe
*.dll
*.sys
*.scr
*.bin
*.zip
*.7z
*.rar
*.vir
*.malware

# Experiment outputs (models and run logs are regenerated from config + seed)
experiments/**
!experiments/.gitkeep
!experiments/README.md
*.joblib
*.npz

# Dashboard scan history (metadata of scanned files) and the synthetic demo corpus
data/*.db
data/demo/**

